#!/system/bin/sh
# Antigravity Shizuku CLI utility; bridges via Antigravity Gateway (uid=2000).
_agy_shizuku_trim() {
  _trimmed="$1"
  while :; do
    case "$_trimmed" in
      " "*|"	"*) _trimmed="${_trimmed#?}" ;;
      *) break ;;
    esac
  done
  while :; do
    case "$_trimmed" in
      *" "|*"	") _trimmed="${_trimmed%?}" ;;
      *) break ;;
    esac
  done
}

_script_dir="${0%/*}"
[ "$_script_dir" = "$0" ] && _script_dir="."
BASEDIR="$(CDPATH= cd -- "$_script_dir" 2>/dev/null && pwd)"
unset _script_dir
if [ -z "${PREFIX:-}" ]; then
  PREFIX="$(CDPATH= cd -- "$BASEDIR/.." 2>/dev/null && pwd)"
fi
FILES_DIR="${PREFIX%/usr}"
if [ -z "${TMPDIR:-}" ]; then
  TMPDIR="$FILES_DIR/tmp"
  [ -d "$TMPDIR" ] || /system/bin/mkdir -p "$TMPDIR" 2>/dev/null || true
  export TMPDIR
fi

SHIZUKU_CONF="$FILES_DIR/logs/shizuku.conf"
SHIZUKU_ENABLED="${AGY_SHIZUKU_ENABLED:-0}"
if [ -r "$SHIZUKU_CONF" ]; then
  _conf_en=""
  while IFS='=' read -r _k _v || [ -n "$_k" ]; do
    _agy_shizuku_trim "$_k"
    if [ "$_trimmed" = "SHIZUKU_ENABLED" ] && [ -z "$_conf_en" ]; then
      _agy_shizuku_trim "$_v"
      _conf_en="$_trimmed"
      break
    fi
  done < "$SHIZUKU_CONF" 2>/dev/null
  [ -n "$_conf_en" ] && SHIZUKU_ENABLED="$_conf_en"
  unset _k _v _conf_en _trimmed
fi

_subcmd="${1:-help}"
case "$_subcmd" in
  -h|--help|help|status) ;;
  *)
    if [ "$SHIZUKU_ENABLED" != "1" ]; then
      echo "agy-shizuku: Shizuku is disabled in Antigravity Settings -> Customizations." >&2
      exit 1
    fi
    ;;
esac

GATEWAY_PORT="${AGY_GATEWAY_PORT:-}"
if [ -z "$GATEWAY_PORT" ] && [ -r "$FILES_DIR/logs/gateway.port" ]; then
  IFS= read -r _gw_raw < "$FILES_DIR/logs/gateway.port" 2>/dev/null || true
  _agy_shizuku_trim "$_gw_raw"
  GATEWAY_PORT="$_trimmed"
  unset _gw_raw _trimmed
fi
GATEWAY_TOKEN="${AGY_GATEWAY_TOKEN:-}"
if [ -z "$GATEWAY_TOKEN" ] && [ -r "$FILES_DIR/logs/gateway.token" ]; then
  IFS= read -r _gw_raw < "$FILES_DIR/logs/gateway.token" 2>/dev/null || true
  _agy_shizuku_trim "$_gw_raw"
  GATEWAY_TOKEN="$_trimmed"
  unset _gw_raw _trimmed
fi

PYTHON_BIN=""
if [ -x "$PREFIX/bin/python3" ]; then
  PYTHON_BIN="$PREFIX/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python3)"
fi
if [ -z "$PYTHON_BIN" ]; then
  echo "agy-shizuku: python3 not found in $PREFIX/bin or PATH." >&2
  exit 1
fi

_py_dir="${PYTHON_BIN%/*}"
_py_lib="${_py_dir%/bin}/lib"
PATH="${PATH:-$PREFIX/bin:/system/bin}"
HOME="${HOME:-$FILES_DIR/home}"
LD_LIBRARY_PATH="${_py_lib}:$PREFIX/lib:/system/lib64"
AGY_GW_PORT="$GATEWAY_PORT"
AGY_GW_TOKEN="$GATEWAY_TOKEN"
AGY_FILES_DIR="$FILES_DIR"
export PATH HOME PREFIX TMPDIR LD_LIBRARY_PATH AGY_GW_PORT AGY_GW_TOKEN AGY_FILES_DIR
unset _py_dir _py_lib
exec "$PYTHON_BIN" - "$@" <<'PYEOF'
import json
import os
import re
import shlex
import shutil
import struct
import sys
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

DEFAULT_PKG = "id.vern.antigravity.turbo"
DEFAULT_COMPONENT = "id.vern.antigravity.turbo/id.vern.antigravity.ui.MainActivity"
PKG_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$")
COMP_RE = re.compile(r"^[A-Za-z0-9_.]+/[A-Za-z0-9_.$]+$")


def print_help():
    print(
        """Usage: agy-shizuku <command> [args]

Commands:
  status [--json]                     Show live Shizuku status via Gateway
  diag [package] [--json]             Structured Android diagnostics (mem/gfx/batt/ANR)
  anr [count]                         Extract recent ANR headers & main-thread traces (default 3)
  logcat [package] [lines] [--all]    Read app warnings/errors or full logcat via uid=2000
  install <apk> [flags]               Install APK via cmd package install -r (uid=2000)
      Flags: --downgrade --grant --relaunch <comp> --self --dry-run
  pkg <action> [arg]                  Manage packages via pm/am/dumpsys:
      Actions: list [-3|-s], info <pkg>, path <pkg>, clear <pkg>,
               force-stop <pkg>, enable <pkg>, disable <pkg>
  ui <action> [args]                  Operate Android UI safely via Shizuku (uid=2000):
      Actions: top, open, dump, find, tap, swipe, scroll, text, key, screen, return
  exec <command...>                   Execute a privileged shell command via uid=2000"""
    )


def require_gateway():
    port = os.environ.get("AGY_GW_PORT", "").strip()
    token = os.environ.get("AGY_GW_TOKEN", "").strip()
    if not port or not token:
        sys.stderr.write("agy-shizuku: Antigravity Gateway port/token unavailable.\n")
        sys.exit(1)
    return port, token


def gw_request(path, payload=None, timeout=30):
    port, token = require_gateway()
    url = f"http://127.0.0.1:{port}{path}"
    data = json.dumps(payload).encode("utf-8") if payload is not None else None
    headers = {"X-AGY-Token": token}
    if data is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method="POST" if data is not None else "GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace")
        try:
            return e.code, json.loads(raw)
        except Exception:
            return e.code, {"ok": False, "error": f"HTTP {e.code}: {raw}"}
    except Exception as e:
        sys.stderr.write(f"agy-shizuku: Gateway request failed ({path}): {e}\n")
        sys.exit(1)


def gw_exec(cmd, mode="shizuku", timeout=35):
    _, data = gw_request("/gateway/exec", {"cmd": cmd, "mode": mode, "source": "agy-shizuku"}, timeout=timeout)
    return data


def valid_pkg(pkg):
    return bool(pkg and len(pkg) <= 160 and PKG_RE.match(pkg))


def cmd_status(args):
    as_json = "--json" in args
    _, shiz = gw_request("/gateway/shizuku")
    if as_json:
        print(json.dumps(shiz, indent=2, ensure_ascii=False))
        return 0 if shiz.get("ok") else 1
    print(f"Shizuku ready     : {shiz.get('ready')} ({shiz.get('state')})")
    print(f"Enabled           : {shiz.get('enabled')}")
    print(f"Backend / Active  : {shiz.get('backend')} -> {shiz.get('active_transport')}")
    print(f"Binder alive/perm : {shiz.get('binder_alive')} / {shiz.get('permission_granted')}")
    print(f"UID / Version     : {shiz.get('uid')} / Shizuku v{shiz.get('shizuku_version')}")
    print(f"rish_shizuku.dex  : {shiz.get('has_rish_dex')}")
    return 0 if shiz.get("ok") else 1


def parse_diag_sections(pkg, raw):
    sections = {}
    current = None
    buf = []
    for line in raw.splitlines():
        s = line.strip()
        if s.startswith("===") and s.endswith("===") and len(s) > 6:
            if current is not None:
                sections[current] = "\n".join(buf)
            current = s[3:-3]
            buf = []
        else:
            buf.append(line)
    if current is not None:
        sections[current] = "\n".join(buf)

    pkg_sec = sections.get("PKG", "")
    vcode_m = re.search(r"versionCode=(\d+)", pkg_sec)
    vname_m = re.search(r"versionName=([^\s]+)", pkg_sec)
    upd_m = re.search(r"lastUpdateTime=(.+)", pkg_sec)

    pid_raw = sections.get("PID", "").strip().split()
    pid = int(pid_raw[0]) if pid_raw and pid_raw[0].isdigit() else None

    batt_sec = sections.get("BATT", "")
    lvl_m = re.search(r"(?m)^\s*level:\s*(\d+)", batt_sec)
    volt_m = re.search(r"(?m)^\s*voltage:\s*(\d+)", batt_sec)
    temp_m = re.search(r"(?m)^\s*temperature:\s*(-?\d+)", batt_sec)
    stat_m = re.search(r"(?m)^\s*status:\s*(\d+)", batt_sec)

    procs_raw = sections.get("PROCS", "").strip().split()
    total_procs = int(procs_raw[0]) if procs_raw and procs_raw[0].isdigit() else None

    mem_sec = sections.get("MEM", "")
    pss_m = re.search(r"TOTAL PSS:\s*(\d+)", mem_sec)
    rss_m = re.search(r"TOTAL RSS:\s*(\d+)", mem_sec)

    gfx_sec = sections.get("GFX", "")
    frames_m = re.search(r"Total frames rendered:\s*(\d+)", gfx_sec)
    jank_m = re.search(r"Janky frames:\s*(\d+)\s*\(([\d.]+)%\)", gfx_sec)
    p50_m = re.search(r"50th percentile:\s*(\d+)ms", gfx_sec)
    p90_m = re.search(r"90th percentile:\s*(\d+)ms", gfx_sec)
    p95_m = re.search(r"95th percentile:\s*(\d+)ms", gfx_sec)
    p99_m = re.search(r"99th percentile:\s*(\d+)ms", gfx_sec)

    anrs = [l.strip() for l in sections.get("ANR", "").splitlines() if l.strip()]

    result = {
        "ok": True,
        "package": pkg,
        "version_name": vname_m.group(1) if vname_m else None,
        "version_code": int(vcode_m.group(1)) if vcode_m else None,
        "last_update_time": upd_m.group(1).strip() if upd_m else None,
        "pid": pid,
        "battery": {
            "level": int(lvl_m.group(1)) if lvl_m else None,
            "voltage_mv": int(volt_m.group(1)) if volt_m else None,
            "temperature_c": round(int(temp_m.group(1)) / 10.0, 1) if temp_m else None,
            "status": int(stat_m.group(1)) if stat_m else None,
        },
        "total_processes": total_procs,
        "meminfo": {
            "total_pss_kb": int(pss_m.group(1)) if pss_m else None,
            "total_rss_kb": int(rss_m.group(1)) if rss_m else None,
        },
        "gfxinfo": {
            "total_frames": int(frames_m.group(1)) if frames_m else None,
            "janky_frames": int(jank_m.group(1)) if jank_m else None,
            "janky_percent": float(jank_m.group(2)) if jank_m else None,
            "p50_ms": int(p50_m.group(1)) if p50_m else None,
            "p90_ms": int(p90_m.group(1)) if p90_m else None,
            "p95_ms": int(p95_m.group(1)) if p95_m else None,
            "p99_ms": int(p99_m.group(1)) if p99_m else None,
        },
        "recent_anrs": anrs,
    }
    bg_sec = sections.get("BG", "")
    if bg_sec.strip():
        doze_m = re.search(r"(?m)^doze_whitelist=(true|false)", bg_sec)
        bkt_m = re.search(r"(?m)^standby_bucket=(\d+)", bg_sec)
        fgs_m = re.search(r"(?m)^fgs_active=(true|false)", bg_sec)
        frz_m = re.search(r"(?m)^cgroup_frozen=(\d+)", bg_sec)
        wl_m = re.search(r"(?m)^wakelock_active=(true|false)", bg_sec)
        result["background"] = {
            "doze_whitelist": (doze_m.group(1) == "true") if doze_m else None,
            "standby_bucket": int(bkt_m.group(1)) if bkt_m else None,
            "fgs_active": (fgs_m.group(1) == "true") if fgs_m else None,
            "cgroup_frozen": int(frz_m.group(1)) if frz_m else None,
            "wakelock_active": (wl_m.group(1) == "true") if wl_m else None,
        }
    return result


def cmd_diag(args):
    as_json = "--json" in args
    pos = [a for a in args if a != "--json"]
    pkg = pos[0] if pos else DEFAULT_PKG
    if not valid_pkg(pkg):
        sys.stderr.write(f"agy-shizuku: invalid package name: {pkg}\n")
        return 2

    q_pkg = urllib.parse.quote(pkg, safe="")
    status_code, data = gw_request(f"/gateway/shizuku/diag?pkg={q_pkg}")
    if status_code >= 400 or "unknown_command" in data:
        q = shlex.quote(pkg)
        shell_diag = (
            f"echo '===PKG==='; dumpsys package {q} | grep -E 'versionCode|versionName|lastUpdateTime' | head -n 5; "
            f"echo '===PID==='; pidof {q} || true; "
            "echo '===BATT==='; dumpsys battery | grep -E 'level:|voltage:|temperature:|status:'; "
            "echo '===PROCS==='; ps -A | wc -l; "
            f"echo '===MEM==='; dumpsys meminfo {q} | grep -E 'TOTAL PSS:|TOTAL:' | head -n 4; "
            f"echo '===GFX==='; dumpsys gfxinfo {q} | head -n 20; "
            "echo '===ANR==='; dumpsys dropbox | grep -E 'data_app_anr|data_app_crash' | tail -n 5; "
            "echo '===BG==='; "
            f"dumpsys deviceidle whitelist | grep -q ',{pkg},' && echo 'doze_whitelist=true' || echo 'doze_whitelist=false'; "
            f"echo \"standby_bucket=$(am get-standby-bucket {q} 2>/dev/null | tr -dc '0-9')\"; "
            f"dumpsys activity services {q} | grep -q 'isForeground=true' && echo 'fgs_active=true' || echo 'fgs_active=false'; "
            f"UID_BG=$(dumpsys package {q} | grep -m1 'appId=' | sed 's/.*appId=//;s/ .*//' | tr -dc '0-9'); "
            "if [ -n \"$UID_BG\" ] && [ -r \"/sys/fs/cgroup/apps/uid_${UID_BG}/cgroup.freeze\" ]; then echo \"cgroup_frozen=$(cat /sys/fs/cgroup/apps/uid_${UID_BG}/cgroup.freeze 2>/dev/null)\"; fi; "
            f"WL_SEC=$(dumpsys power | sed -n '/Wake Locks:/,/^$/p'); "
            f"if printf '%s\\n' \"$WL_SEC\" | grep -Fq {q} || {{ [ -n \"$UID_BG\" ] && printf '%s\\n' \"$WL_SEC\" | grep -Eq \"uid=${{UID_BG}}([^0-9]|$)\"; }}; then echo 'wakelock_active=true'; else echo 'wakelock_active=false'; fi"
        )
        res = gw_exec(shell_diag)
        if not res.get("ok"):
            if as_json:
                print(json.dumps(res, indent=2, ensure_ascii=False))
            else:
                sys.stderr.write(f"agy-shizuku: diag failed: {res.get('error') or res.get('stderr')}\n")
            return 1
        data = parse_diag_sections(pkg, res.get("stdout") or "")
        data["transport"] = res.get("transport")
        data["uid"] = res.get("uid")
        data["duration_ms"] = res.get("duration_ms")

    if as_json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0 if data.get("ok") else 1

    if not data.get("ok"):
        sys.stderr.write(f"agy-shizuku: diag error: {data.get('error')}\n")
        return 1

    batt = data.get("battery") or {}
    mem = data.get("meminfo") or {}
    gfx = data.get("gfxinfo") or {}
    anrs = data.get("recent_anrs") or []
    print(f"Package    : {data.get('package')} v{data.get('version_name')} (code {data.get('version_code')})")
    print(f"Updated    : {data.get('last_update_time')}")
    print(f"PID        : {data.get('pid')} (via {data.get('transport')}, uid={data.get('uid')}, {data.get('duration_ms')}ms)")
    print(f"OS Procs   : {data.get('total_processes')}")
    print(f"Battery    : {batt.get('level')}% | {batt.get('temperature_c')}C | {batt.get('voltage_mv')}mV | status={batt.get('status')}")
    print(f"Memory     : PSS={mem.get('total_pss_kb')} KB | RSS={mem.get('total_rss_kb')} KB")
    print(
        f"Graphics   : frames={gfx.get('total_frames')} | jank={gfx.get('janky_frames')} "
        f"({gfx.get('janky_percent')}%) | p50={gfx.get('p50_ms')}ms p90={gfx.get('p90_ms')}ms p99={gfx.get('p99_ms')}ms"
    )
    bg = data.get("background")
    if isinstance(bg, dict):
        print(
            f"Background : doze_exempt={bg.get('doze_whitelist')} | bucket={bg.get('standby_bucket')} | "
            f"fgs={bg.get('fgs_active')} | frozen={bg.get('cgroup_frozen')} | wakelock={bg.get('wakelock_active')}"
        )
    print(f"Recent ANR : {len(anrs)} entry(s)")
    for entry in anrs:
        print(f"  - {entry}")
    return 0


def cmd_anr(args):
    count = 3
    if args:
        try:
            count = max(1, min(10, int(args[0])))
        except ValueError:
            sys.stderr.write(f"agy-shizuku: invalid ANR count: {args[0]}\n")
            return 2

    awk_cmd = r"""dumpsys dropbox --print data_app_anr | awk '
/^========================================/ { if (buf != "") print buf; buf=""; printed_main=0; in_main=0; next }
/^20[0-9][0-9]-|^Process:|^Package:|^Subject:/ { buf = (buf == "" ? $0 : buf "\n" $0); next }
/^"main" / && !printed_main { in_main=1; buf = buf "\n  " $0; next }
in_main && /^  (native: #0[012]|at id\.vern|at android\.view\.Choreographer\.doFrame|  - waiting|  - locked)/ { buf = buf "\n  " $0 }
in_main && /^$/ { in_main=0; printed_main=1 }
END { if (buf != "") print buf }
'"""
    res = gw_exec(awk_cmd, timeout=30)
    if not res.get("ok"):
        sys.stderr.write(f"agy-shizuku: anr query failed: {res.get('error') or res.get('stderr')}\n")
        return 1
    stdout = res.get("stdout") or ""
    blocks = []
    cur = []
    for line in stdout.splitlines():
        if re.match(r"^20\d\d-\d\d-\d\d ", line) and cur:
            blocks.append("\n".join(cur))
            cur = [line]
        else:
            cur.append(line)
    if cur:
        blocks.append("\n".join(cur))
    if not blocks:
        print("No data_app_anr entries found in DropBox.")
        return 0
    for blk in blocks[-count:]:
        print(blk)
        print("-" * 60)
    return 0


def cmd_logcat(args):
    show_all = "--all" in args
    rest = [a for a in args if a != "--all"]
    pkg = DEFAULT_PKG
    lines = 30
    for item in rest:
        if item.isdigit():
            lines = max(1, min(200, int(item)))
        else:
            pkg = item
    if not valid_pkg(pkg):
        sys.stderr.write(f"agy-shizuku: invalid package name: {pkg}\n")
        return 2
    q = shlex.quote(pkg)
    lvl = "" if show_all else "*:W"
    cmd = (
        f"_pid=$(pidof {q} | awk '{{print $1}}'); "
        f"[ -n \"$_pid\" ] || {{ echo \"Package {pkg} is not running\" >&2; exit 1; }}; "
        f"logcat -d -v time --pid=\"$_pid\" {lvl} | grep -v 'audit(' | tail -n {lines}"
    )
    res = gw_exec(cmd)
    if res.get("stdout"):
        print(res["stdout"])
    if res.get("stderr"):
        sys.stderr.write(res["stderr"] + "\n")
    return 0 if res.get("ok") else 1


def cmd_install(args):
    downgrade = False
    grant = False
    dry_run = False
    relaunch = None
    apk_path = None
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--downgrade":
            downgrade = True
        elif a == "--grant":
            grant = True
        elif a == "--dry-run":
            dry_run = True
        elif a == "--self":
            relaunch = DEFAULT_COMPONENT
        elif a == "--relaunch":
            if i + 1 >= len(args):
                sys.stderr.write("agy-shizuku: --relaunch requires a component (pkg/Activity).\n")
                return 2
            relaunch = args[i + 1]
            i += 1
        elif a.startswith("-"):
            sys.stderr.write(f"agy-shizuku: unknown install option: {a}\n")
            return 2
        elif apk_path is None:
            apk_path = a
        else:
            sys.stderr.write(f"agy-shizuku: unexpected extra argument: {a}\n")
            return 2
        i += 1

    if not apk_path:
        sys.stderr.write("agy-shizuku: install requires <apk_path>.\n")
        return 2
    if relaunch and not COMP_RE.match(relaunch):
        sys.stderr.write(f"agy-shizuku: invalid component name: {relaunch}\n")
        return 2

    real_apk = os.path.abspath(apk_path)
    if not os.path.isfile(real_apk):
        sys.stderr.write(f"agy-shizuku: APK file not found: {real_apk}\n")
        return 1
    with open(real_apk, "rb") as f:
        magic = f.read(4)
    if magic != b"PK\x03\x04":
        sys.stderr.write(f"agy-shizuku: invalid APK (bad ZIP header): {real_apk}\n")
        return 1

    size = os.path.getsize(real_apk)
    flags = ["-r"]
    if downgrade:
        flags.append("-d")
    if grant:
        flags.append("-g")
    flags.extend(["-S", str(size)])

    needs_stage = not (real_apk.startswith("/storage/emulated/0/") or real_apk.startswith("/sdcard/"))
    staged_path = f"/storage/emulated/0/Download/.agy-shizuku-stage-{os.getpid()}.apk" if needs_stage else real_apk
    install_cmd = f"cmd package install {' '.join(flags)} < {shlex.quote(staged_path)}"

    if dry_run:
        print(f"DRY RUN: valid APK ({size} bytes): {real_apk}")
        print(f"Staging : {'yes -> ' + staged_path if needs_stage else 'no (direct shared storage read)'}")
        if relaunch:
            print(f"Relaunch: {relaunch} (detached)")
        print(f"Command : {install_cmd}")
        return 0

    if needs_stage:
        shutil.copy2(real_apk, staged_path)

    if relaunch:
        cleanup_cmd = f"rm -f {shlex.quote(staged_path)}; " if needs_stage else ""
        inner = (
            f"sleep 1; {install_cmd}; _rc=$?; {cleanup_cmd}"
            f"if [ \"$_rc\" -eq 0 ]; then am start -n {shlex.quote(relaunch)} >/dev/null 2>&1; fi"
        )
        detached = f"nohup /system/bin/sh -c {shlex.quote(inner)} >/dev/null 2>&1 &"
        res = gw_exec(detached, timeout=15)
        if not res.get("ok"):
            if needs_stage and os.path.exists(staged_path):
                os.remove(staged_path)
            sys.stderr.write(f"agy-shizuku: failed launching detached install: {res.get('error')}\n")
            return 1
        print(f"Detached install + relaunch scheduled for {real_apk} ({size} bytes).")
        return 0

    try:
        res = gw_exec(install_cmd, timeout=60)
        if res.get("stdout"):
            print(res["stdout"])
        if res.get("stderr"):
            sys.stderr.write(res["stderr"] + "\n")
        return 0 if res.get("ok") else 1
    finally:
        if needs_stage and os.path.exists(staged_path):
            try:
                os.remove(staged_path)
            except OSError:
                pass


def cmd_pkg(args):
    if not args:
        sys.stderr.write("agy-shizuku: pkg requires an action (list|info|path|clear|force-stop|enable|disable).\n")
        return 2
    action = args[0]
    arg = args[1] if len(args) > 1 else ""
    if action == "list":
        filter_flag = ""
        if arg in ("-3", "-s"):
            filter_flag = f" {arg}"
        elif arg:
            sys.stderr.write("agy-shizuku: pkg list only accepts optional -3 or -s.\n")
            return 2
        res = gw_exec(f"pm list packages{filter_flag}")
    else:
        if not valid_pkg(arg):
            sys.stderr.write(f"agy-shizuku: valid package name required for 'pkg {action}'.\n")
            return 2
        q = shlex.quote(arg)
        mapping = {
            "info": f"dumpsys package {q} | grep -E 'Package \\[|versionCode|versionName|userId=|firstInstallTime|lastUpdateTime|dataDir=|codePath=' | head -n 15",
            "path": f"pm path {q}",
            "clear": f"pm clear {q}",
            "force-stop": f"am force-stop {q}",
            "enable": f"pm enable {q}",
            "disable": f"pm disable-user --user 0 {q}",
        }
        if action not in mapping:
            sys.stderr.write(f"agy-shizuku: unknown pkg action: {action}\n")
            return 2
        res = gw_exec(mapping[action])

    if res.get("stdout"):
        print(res["stdout"])
    if res.get("stderr"):
        sys.stderr.write(res["stderr"] + "\n")
    elif not res.get("ok") and res.get("error"):
        sys.stderr.write(f"agy-shizuku: {res['error']}\n")
    return 0 if res.get("ok") else 1


UI_KEY_MAP = {
    "back": 4,
    "home": 3,
    "enter": 66,
    "recents": 187,
    "tab": 61,
    "del": 67,
    "escape": 111,
    "media_play_pause": 85,
    "media_next": 87,
    "media_prev": 88,
    "volume_up": 24,
    "volume_down": 25,
}


def print_ui_help():
    print(
        """Usage: agy-shizuku ui <action> [args]

Actions:
  top [--json]                             Show foreground package, wakefulness, screen size
  open <pkg|pkg/Activity|android.action>   Launch app or Settings action
  dump [--json] [--pkg <pkg>] [--clickable] Parse UI hierarchy XML with center coords
  find <query> [--pkg <pkg>] [--clickable] [--json]
                                           Find nodes by text/desc/resource-id
  tap <x> <y> [--expect-pkg <pkgs>] [--allow-self]
  swipe <x1> <y1> <x2> <y2> [ms] [--expect-pkg <pkgs>] [--allow-self]
  scroll <down|up|left|right> [--duration <ms>] [--expect-pkg <pkgs>] [--allow-self]
  text "<text>" [--expect-pkg <pkgs>] [--allow-self]
  key <name|code> [--expect-pkg <pkgs>] [--allow-self]
  screen <output.png>                      Capture screenshot via screencap -p
  return                                   Bring Antigravity MainActivity back to front"""
    )


def ui_parse_bounds(bounds_str):
    m = re.match(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", bounds_str or "")
    if not m:
        return None
    x1, y1, x2, y2 = map(int, m.groups())
    if x2 <= x1 or y2 <= y1:
        return None
    return x1, y1, x2, y2, (x1 + x2) // 2, (y1 + y2) // 2


def ui_top_info():
    cmd = (
        "echo '===ACT==='; dumpsys activity activities | grep -E 'topResumedActivity|ResumedActivity' | head -n 4; "
        "echo '===WAKE==='; dumpsys power | grep -E 'mWakefulness=' | head -n 1; "
        "echo '===WM==='; wm size"
    )
    res = gw_exec(cmd, timeout=15)
    if not res.get("ok"):
        return {"ok": False, "error": res.get("error") or res.get("stderr") or "top query failed"}
    raw = res.get("stdout") or ""
    sections = {}
    cur = None
    buf = []
    for line in raw.splitlines():
        s = line.strip()
        if s.startswith("===") and s.endswith("===") and len(s) > 6:
            if cur is not None:
                sections[cur] = "\n".join(buf)
            cur = s[3:-3]
            buf = []
        else:
            buf.append(line)
    if cur is not None:
        sections[cur] = "\n".join(buf)

    act_lines = [l.strip() for l in sections.get("ACT", "").splitlines() if l.strip()]
    picked = next((l for l in act_lines if "topResumedActivity=" in l), act_lines[0] if act_lines else "")
    comp_m = re.search(r"\bu\d+\s+([^\s}]+/[^\s}]+)", picked)
    component = comp_m.group(1) if comp_m else ""
    pkg = component.split("/", 1)[0] if "/" in component else ""

    wake_m = re.search(r"mWakefulness=([^\s]+)", sections.get("WAKE", ""))
    wake = wake_m.group(1) if wake_m else "Unknown"

    wm_sec = sections.get("WM", "")
    ov_m = re.search(r"Override size:\s*(\d+)x(\d+)", wm_sec)
    ph_m = re.search(r"Physical size:\s*(\d+)x(\d+)", wm_sec)
    sz_m = ov_m or ph_m
    width = int(sz_m.group(1)) if sz_m else 1080
    height = int(sz_m.group(2)) if sz_m else 2400

    return {
        "ok": True,
        "package": pkg,
        "component": component,
        "wakefulness": wake,
        "width": width,
        "height": height,
    }


def extract_ui_guard_flags(args):
    expect_pkgs = None
    allow_self = False
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--allow-self":
            allow_self = True
        elif a == "--expect-pkg":
            if i + 1 >= len(args):
                raise ValueError("--expect-pkg requires a package list")
            expect_pkgs = args[i + 1]
            i += 1
        elif a.startswith("--expect-pkg="):
            expect_pkgs = a.split("=", 1)[1]
        else:
            rest.append(a)
        i += 1
    return rest, expect_pkgs, allow_self


def ui_guard(action, expect_pkgs=None, allow_self=False):
    info = ui_top_info()
    if not info.get("ok"):
        sys.stderr.write(f"agy-shizuku ui: failed checking foreground state: {info.get('error')}\n")
        return None, 1
    cur_pkg = info.get("package") or ""
    if expect_pkgs:
        allowed = {p.strip() for p in expect_pkgs.split(",") if p.strip()}
        if cur_pkg not in allowed:
            sys.stderr.write(
                f"agy-shizuku ui: Refusing '{action}': foreground package '{cur_pkg}' not in {sorted(allowed)}.\n"
            )
            return None, 3
    if not allow_self and cur_pkg == DEFAULT_PKG and action in ("back", "tap", "swipe", "scroll", "text"):
        sys.stderr.write(
            f"agy-shizuku ui: Refusing '{action}' while {DEFAULT_PKG} is in foreground; pass --allow-self to override.\n"
        )
        return None, 3
    return info, 0


def ui_dump_nodes(pkg_filter=None, clickable_only=False):
    tmp_xml = f"/data/local/tmp/agy_ui_dump_{os.getpid()}.xml"
    q_xml = shlex.quote(tmp_xml)
    res = gw_exec(f"uiautomator dump --compressed {q_xml} >/dev/null && cat {q_xml}; rm -f {q_xml}", timeout=30)
    out = res.get("stdout") or ""
    if not res.get("ok") or "<hierarchy" not in out:
        err = res.get("stderr") or res.get("error") or out[:200]
        raise RuntimeError(f"uiautomator dump failed: {err}")
    root = ET.fromstring(out[out.index("<hierarchy"):])
    nodes = []
    for idx, n in enumerate(root.iter("node")):
        pkg = (n.attrib.get("package") or "").strip()
        if pkg_filter and pkg != pkg_filter:
            continue
        clickable = n.attrib.get("clickable") == "true"
        if clickable_only and not clickable:
            continue
        b_str = n.attrib.get("bounds") or ""
        parsed_b = ui_parse_bounds(b_str)
        nodes.append({
            "index": idx,
            "package": pkg,
            "text": (n.attrib.get("text") or "").strip(),
            "desc": (n.attrib.get("content-desc") or "").strip(),
            "rid": (n.attrib.get("resource-id") or "").strip(),
            "class": (n.attrib.get("class") or "").strip(),
            "clickable": clickable,
            "selected": n.attrib.get("selected") == "true",
            "enabled": n.attrib.get("enabled") == "true",
            "bounds": b_str,
            "cx": parsed_b[4] if parsed_b else None,
            "cy": parsed_b[5] if parsed_b else None,
        })
    return nodes


def cmd_ui(args):
    if not args or args[0] in ("-h", "--help", "help"):
        print_ui_help()
        return 0
    action = args[0]
    rest = args[1:]

    if action == "top":
        as_json = "--json" in rest
        info = ui_top_info()
        if as_json:
            print(json.dumps(info, indent=2, ensure_ascii=False))
            return 0 if info.get("ok") else 1
        if not info.get("ok"):
            sys.stderr.write(f"agy-shizuku ui top failed: {info.get('error')}\n")
            return 1
        print(f"Package     : {info.get('package')}")
        print(f"Component   : {info.get('component')}")
        print(f"Wakefulness : {info.get('wakefulness')}")
        print(f"Screen      : {info.get('width')}x{info.get('height')}")
        return 0

    if action == "open":
        if not rest:
            sys.stderr.write("agy-shizuku ui: open requires <pkg | pkg/Activity | android.action>.\n")
            return 2
        target = rest[0].strip()
        if "/" in target:
            if not COMP_RE.match(target):
                sys.stderr.write(f"agy-shizuku ui: invalid component: {target}\n")
                return 2
            res = gw_exec(f"am start -W -n {shlex.quote(target)}", timeout=25)
        elif target.startswith("android."):
            if not re.match(r"^[A-Za-z0-9_.]+$", target):
                sys.stderr.write(f"agy-shizuku ui: invalid action: {target}\n")
                return 2
            res = gw_exec(f"am start -W -a {shlex.quote(target)}", timeout=25)
        else:
            if not valid_pkg(target):
                sys.stderr.write(f"agy-shizuku ui: invalid package name: {target}\n")
                return 2
            res = gw_exec(
                f"monkey -p {shlex.quote(target)} -c android.intent.category.LAUNCHER 1",
                timeout=25,
            )
        if res.get("stdout"):
            print(res["stdout"])
        if res.get("stderr"):
            sys.stderr.write(res["stderr"] + "\n")
        return 0 if res.get("ok") else 1

    if action == "return":
        res = gw_exec(f"am start -n {shlex.quote(DEFAULT_COMPONENT)}", timeout=15)
        if res.get("stdout"):
            print(res["stdout"])
        if res.get("stderr"):
            sys.stderr.write(res["stderr"] + "\n")
        return 0 if res.get("ok") else 1

    if action == "dump":
        as_json = False
        clickable_only = False
        pkg_filter = None
        i = 0
        while i < len(rest):
            a = rest[i]
            if a == "--json":
                as_json = True
            elif a == "--clickable":
                clickable_only = True
            elif a == "--pkg":
                if i + 1 >= len(rest):
                    sys.stderr.write("agy-shizuku ui: --pkg requires a package name.\n")
                    return 2
                pkg_filter = rest[i + 1]
                i += 1
            else:
                sys.stderr.write(f"agy-shizuku ui: unknown dump option: {a}\n")
                return 2
            i += 1
        try:
            nodes = ui_dump_nodes(pkg_filter=pkg_filter, clickable_only=clickable_only)
        except Exception as e:
            sys.stderr.write(f"agy-shizuku ui: {e}\n")
            return 1
        if as_json:
            print(json.dumps(nodes, indent=2, ensure_ascii=False))
            return 0
        for n in nodes:
            if not (n["text"] or n["desc"] or n["rid"] or n["clickable"]):
                continue
            center = f"({n['cx']},{n['cy']})" if n["cx"] is not None else "(-,-)"
            flags = "C" if n["clickable"] else "-"
            print(f"[{n['index']:03d}] {flags} {center} pkg={n['package']} rid={n['rid']!r} text={n['text']!r} desc={n['desc']!r}")
        return 0

    if action == "find":
        as_json = False
        clickable_only = False
        pkg_filter = None
        query = None
        i = 0
        while i < len(rest):
            a = rest[i]
            if a == "--json":
                as_json = True
            elif a == "--clickable":
                clickable_only = True
            elif a == "--pkg":
                if i + 1 >= len(rest):
                    sys.stderr.write("agy-shizuku ui: --pkg requires a package name.\n")
                    return 2
                pkg_filter = rest[i + 1]
                i += 1
            elif a.startswith("-"):
                sys.stderr.write(f"agy-shizuku ui: unknown find option: {a}\n")
                return 2
            elif query is None:
                query = a
            else:
                query = f"{query} {a}"
            i += 1
        if not query:
            sys.stderr.write("agy-shizuku ui: find requires <query>.\n")
            return 2
        try:
            nodes = ui_dump_nodes(pkg_filter=pkg_filter, clickable_only=clickable_only)
        except Exception as e:
            sys.stderr.write(f"agy-shizuku ui: {e}\n")
            return 1
        ql = query.lower()
        hits = []
        for n in nodes:
            if n["cx"] is None:
                continue
            tl = n["text"].lower()
            dl = n["desc"].lower()
            rl = n["rid"].lower()
            score = 0
            if tl == ql or dl == ql:
                score += 20
            elif ql in tl or ql in dl:
                score += 10
            elif ql in rl:
                score += 6
            else:
                continue
            if n["clickable"]:
                score += 4
            hits.append((score, n))
        hits.sort(key=lambda pair: (-pair[0], pair[1]["index"]))
        matched = [n for _, n in hits]
        if as_json:
            print(json.dumps(matched, indent=2, ensure_ascii=False))
        else:
            for n in matched:
                print(
                    f"({n['cx']},{n['cy']}) bounds={n['bounds']} clickable={n['clickable']} "
                    f"rid={n['rid']!r} text={n['text']!r} desc={n['desc']!r}"
                )
        return 0 if matched else 1

    if action == "screen":
        if not rest:
            sys.stderr.write("agy-shizuku ui: screen requires <output.png>.\n")
            return 2
        real_out = os.path.abspath(rest[0])
        stage = f"/storage/emulated/0/Download/.agy-shizuku-screen-{os.getpid()}.png"
        try:
            res = gw_exec(f"screencap -p {shlex.quote(stage)}", timeout=20)
            if not res.get("ok") or not os.path.isfile(stage):
                sys.stderr.write(f"agy-shizuku ui: screencap failed: {res.get('error') or res.get('stderr')}\n")
                return 1
            with open(stage, "rb") as f:
                hdr = f.read(24)
            if len(hdr) < 24 or hdr[:8] != b"\x89PNG\r\n\x1a\n":
                sys.stderr.write("agy-shizuku ui: screencap did not produce a valid PNG.\n")
                return 1
            parent = os.path.dirname(real_out)
            if parent:
                os.makedirs(parent, exist_ok=True)
            shutil.move(stage, real_out)
            w, h = struct.unpack(">II", hdr[16:24])
            size = os.path.getsize(real_out)
            print(f"Saved screenshot: {real_out} ({size} bytes, {w}x{h})")
            return 0
        finally:
            if os.path.exists(stage):
                try:
                    os.remove(stage)
                except OSError:
                    pass

    try:
        clean_args, expect_pkgs, allow_self = extract_ui_guard_flags(rest)
    except ValueError as e:
        sys.stderr.write(f"agy-shizuku ui: {e}\n")
        return 2

    if action == "tap":
        if len(clean_args) != 2:
            sys.stderr.write("agy-shizuku ui: tap requires <x> <y>.\n")
            return 2
        try:
            x, y = int(clean_args[0]), int(clean_args[1])
        except ValueError:
            sys.stderr.write("agy-shizuku ui: tap coordinates must be integers.\n")
            return 2
        if not (0 <= x <= 10000 and 0 <= y <= 10000):
            sys.stderr.write("agy-shizuku ui: tap coordinates out of bounds.\n")
            return 2
        _, rc = ui_guard("tap", expect_pkgs=expect_pkgs, allow_self=allow_self)
        if rc != 0:
            return rc
        res = gw_exec(f"input tap {x} {y}", timeout=15)
        return 0 if res.get("ok") else 1

    if action == "swipe":
        if len(clean_args) not in (4, 5):
            sys.stderr.write("agy-shizuku ui: swipe requires <x1> <y1> <x2> <y2> [duration_ms].\n")
            return 2
        try:
            x1, y1, x2, y2 = (int(v) for v in clean_args[:4])
            dur = int(clean_args[4]) if len(clean_args) == 5 else 300
        except ValueError:
            sys.stderr.write("agy-shizuku ui: swipe coordinates and duration must be integers.\n")
            return 2
        if not (50 <= dur <= 5000):
            sys.stderr.write("agy-shizuku ui: swipe duration_ms must be between 50 and 5000.\n")
            return 2
        _, rc = ui_guard("swipe", expect_pkgs=expect_pkgs, allow_self=allow_self)
        if rc != 0:
            return rc
        res = gw_exec(f"input swipe {x1} {y1} {x2} {y2} {dur}", timeout=15)
        return 0 if res.get("ok") else 1

    if action == "scroll":
        dur = 320
        direction = None
        i = 0
        while i < len(clean_args):
            a = clean_args[i]
            if a == "--duration":
                if i + 1 >= len(clean_args):
                    sys.stderr.write("agy-shizuku ui: --duration requires milliseconds.\n")
                    return 2
                try:
                    dur = int(clean_args[i + 1])
                except ValueError:
                    sys.stderr.write("agy-shizuku ui: invalid duration.\n")
                    return 2
                i += 1
            elif direction is None:
                direction = a.lower()
            else:
                sys.stderr.write(f"agy-shizuku ui: unexpected scroll arg: {a}\n")
                return 2
            i += 1
        if direction not in ("down", "up", "left", "right") or not (50 <= dur <= 5000):
            sys.stderr.write("agy-shizuku ui: scroll requires <down|up|left|right> and duration 50..5000ms.\n")
            return 2
        info, rc = ui_guard("scroll", expect_pkgs=expect_pkgs, allow_self=allow_self)
        if rc != 0:
            return rc
        w, h = info["width"], info["height"]
        coords = {
            "down": (w // 2, int(h * 0.72), w // 2, int(h * 0.28)),
            "up": (w // 2, int(h * 0.28), w // 2, int(h * 0.72)),
            "left": (int(w * 0.82), h // 2, int(w * 0.18), h // 2),
            "right": (int(w * 0.18), h // 2, int(w * 0.82), h // 2),
        }[direction]
        res = gw_exec(f"input swipe {coords[0]} {coords[1]} {coords[2]} {coords[3]} {dur}", timeout=15)
        return 0 if res.get("ok") else 1

    if action == "text":
        if not clean_args:
            sys.stderr.write("agy-shizuku ui: text requires <string>.\n")
            return 2
        raw_text = " ".join(clean_args) if len(clean_args) > 1 else clean_args[0]
        encoded = raw_text.replace(" ", "%s")
        _, rc = ui_guard("text", expect_pkgs=expect_pkgs, allow_self=allow_self)
        if rc != 0:
            return rc
        res = gw_exec(f"input text {shlex.quote(encoded)}", timeout=15)
        return 0 if res.get("ok") else 1

    if action == "key":
        if len(clean_args) != 1:
            sys.stderr.write("agy-shizuku ui: key requires <name|keycode>.\n")
            return 2
        raw_key = clean_args[0].lower()
        if raw_key in UI_KEY_MAP:
            keycode = UI_KEY_MAP[raw_key]
        else:
            try:
                keycode = int(raw_key)
            except ValueError:
                sys.stderr.write(f"agy-shizuku ui: unknown key '{clean_args[0]}'.\n")
                return 2
            if not (0 <= keycode <= 400):
                sys.stderr.write("agy-shizuku ui: numeric keycode must be 0..400.\n")
                return 2
        guard_action = "back" if keycode == 4 else f"key:{raw_key}"
        _, rc = ui_guard(guard_action, expect_pkgs=expect_pkgs, allow_self=allow_self)
        if rc != 0:
            return rc
        res = gw_exec(f"input keyevent {keycode}", timeout=15)
        return 0 if res.get("ok") else 1

    sys.stderr.write(f"agy-shizuku ui: unknown action '{action}'. Run 'agy-shizuku ui --help'.\n")
    return 2


def cmd_exec(args):
    if not args:
        sys.stderr.write("agy-shizuku: exec requires a shell command.\n")
        return 2
    cmd = " ".join(args) if len(args) > 1 else args[0]
    res = gw_exec(cmd)
    if res.get("stdout"):
        print(res["stdout"])
    if res.get("stderr"):
        sys.stderr.write(res["stderr"] + "\n")
    elif not res.get("ok") and res.get("error"):
        sys.stderr.write(f"agy-shizuku: {res['error']}\n")
    if res.get("ok"):
        return 0
    rc = res.get("exit_code")
    return rc if isinstance(rc, int) and rc > 0 else 1


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print_help()
        return 0

    sub = argv[0]
    rest = argv[1:]
    dispatch = {
        "status": cmd_status,
        "diag": cmd_diag,
        "anr": cmd_anr,
        "logcat": cmd_logcat,
        "install": cmd_install,
        "pkg": cmd_pkg,
        "ui": cmd_ui,
        "exec": cmd_exec,
    }
    handler = dispatch.get(sub)
    if handler is None:
        sys.stderr.write(f"agy-shizuku: unknown command '{sub}'. Run 'agy-shizuku --help'.\n")
        return 2
    return handler(rest)


if __name__ == "__main__":
    sys.exit(main())
