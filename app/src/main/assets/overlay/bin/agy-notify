#!/system/bin/sh
if [ -z "${BASH_VERSION:-}" ]; then
    if [ -x "$(dirname "$0")/bash" ]; then
        exec "$(dirname "$0")/bash" "$0" "$@"
    elif command -v bash >/dev/null 2>&1; then
        exec bash "$0" "$@"
    fi
fi
# agy-notify - Post and manage Android notifications.
set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
PREFIX="${PREFIX:-$(cd -- "$SCRIPT_DIR/.." 2>/dev/null && pwd)}"
FILES_DIR="$(cd -- "$PREFIX/.." 2>/dev/null && pwd)"
RISH_BIN="$PREFIX/bin/rish"
GATEWAY_PORT="${AGY_GATEWAY_PORT:-$(tr -d '[:space:]' < "$FILES_DIR/logs/gateway.port" 2>/dev/null || true)}"
GATEWAY_TOKEN="${AGY_GATEWAY_TOKEN:-$(tr -d '[:space:]' < "$FILES_DIR/logs/gateway.token" 2>/dev/null || true)}"
PYTHON_BIN=""
if [ -x "$PREFIX/bin/python3" ]; then
    PYTHON_BIN="$PREFIX/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
fi

is_shizuku_enabled() {
    _conf="$FILES_DIR/logs/shizuku.conf"
    if [ -r "$_conf" ]; then
        _val="$(sed -n 's/^SHIZUKU_ENABLED=//p' "$_conf" 2>/dev/null | head -n 1 | tr -d '[:space:]')"
        [ "$_val" = "1" ]
        return $?
    fi
    [ "${AGY_SHIZUKU_ENABLED:-0}" = "1" ]
}

notify_via_gateway() {
    [ -n "$GATEWAY_PORT" ] && [ -n "$GATEWAY_TOKEN" ] && [ -n "$PYTHON_BIN" ] || return 1
    AGY_NOTIFY_ACTION="$1" \
    AGY_NOTIFY_TITLE="$2" \
    AGY_NOTIFY_MSG="$3" \
    AGY_NOTIFY_TAG="$4" \
    AGY_GW_PORT="$GATEWAY_PORT" \
    AGY_GW_TOKEN="$GATEWAY_TOKEN" \
    "$PYTHON_BIN" - <<'PYEOF'
import json, os, sys, urllib.request, zlib
tag = os.environ.get("AGY_NOTIFY_TAG", "agy_task")
notif_id = int(zlib.crc32(tag.encode("utf-8")) & 0x7fffffff)
payload = {
    "action": os.environ.get("AGY_NOTIFY_ACTION", "post"),
    "title": os.environ.get("AGY_NOTIFY_TITLE", "Antigravity"),
    "message": os.environ.get("AGY_NOTIFY_MSG", ""),
    "tag": tag,
    "id": notif_id,
}
req = urllib.request.Request(
    f"http://127.0.0.1:{os.environ['AGY_GW_PORT']}/gateway/notify",
    data=json.dumps(payload).encode("utf-8"),
    headers={
        "Content-Type": "application/json",
        "X-AGY-Token": os.environ["AGY_GW_TOKEN"],
    },
    method="POST",
)
try:
    with urllib.request.urlopen(req, timeout=3) as resp:
        data = json.loads(resp.read().decode("utf-8", errors="replace"))
        sys.exit(0 if data.get("ok") else 1)
except Exception:
    sys.exit(1)
PYEOF
}

USAGE="Usage: agy-notify [post|cancel|list] [options]
Commands:
  post    -t <title> [-s <subtitle>] [-m <message>] [--tag <tag>]
  cancel  <tag>
  list    Show active notifications
"

CMD="${1:-post}"
shift || true

TITLE="Antigravity"
SUBTITLE=""
MESSAGE=""
TAG="agy_$(date +%s)"

if [ "$CMD" = "cancel" ]; then
    if [ "$#" -ne 1 ] || [ -z "$1" ]; then
        echo "agy-notify: cancel requires exactly one tag" >&2
        echo "$USAGE" >&2
        exit 2
    fi
    TAG="$1"
    set --
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--title)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            TITLE="$2"
            shift 2
            ;;
        -s|--subtitle)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            SUBTITLE="$2"
            shift 2
            ;;
        -m|--message)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            MESSAGE="$2"
            shift 2
            ;;
        --tag)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            TAG="$2"
            shift 2
            ;;
        *)
            if [ -z "$MESSAGE" ]; then
                MESSAGE="$1"
            fi
            shift
            ;;
    esac
done

if [ "$CMD" = "post" ]; then
    if [ -z "$MESSAGE" ] && [ -n "$TITLE" ]; then
        MESSAGE="$TITLE"
        TITLE="Antigravity"
    fi

    BODY_TEXT="$MESSAGE"
    if [ -n "$SUBTITLE" ]; then
        BODY_TEXT="[$SUBTITLE] $MESSAGE"
    fi

    if notify_via_gateway "post" "$TITLE" "$BODY_TEXT" "$TAG"; then
        exit 0
    fi

    if is_shizuku_enabled && [ -x "$RISH_BIN" ]; then
        # Optional high-resolution logo cache with safe fallback to system default icon.
        LOGO_CACHE="/data/local/tmp/agy_logo.png"
        SRC_LOGO=""
        for candidate in "${AGY_LOGO:-}" "$PREFIX/share/antigravity/logo.png" "$PREFIX/share/pixmaps/antigravity.png"; do
            if [ -n "$candidate" ] && [ -f "$candidate" ]; then
                SRC_LOGO="$candidate"
                break
            fi
        done

        LARGE_ICON_OPT=""
        if [ -n "$SRC_LOGO" ]; then
            if ! "$RISH_BIN" -c "test -f $LOGO_CACHE" 2>/dev/null; then
                "$RISH_BIN" -c "cp -f $(printf %q "$SRC_LOGO") $(printf %q "$LOGO_CACHE") && chmod 644 $(printf %q "$LOGO_CACHE")" 2>/dev/null || true
            fi
            if "$RISH_BIN" -c "test -f $LOGO_CACHE" 2>/dev/null; then
                LARGE_ICON_OPT="-I file://$LOGO_CACHE"
            fi
        fi

        "$RISH_BIN" -c "cmd notification post -S bigtext $LARGE_ICON_OPT -t $(printf %q "$TITLE") $(printf %q "$TAG") $(printf %q "$BODY_TEXT")" 2>/dev/null && exit 0
    fi

    cmd notification post -S bigtext -t "$TITLE" "$TAG" "$BODY_TEXT" 2>/dev/null && exit 0 || true
    echo "[agy-notify] notification queued: $TITLE - $MESSAGE"

elif [ "$CMD" = "cancel" ]; then
    if notify_via_gateway "cancel" "" "" "$TAG"; then
        exit 0
    fi
    if is_shizuku_enabled && [ -x "$RISH_BIN" ]; then
        "$RISH_BIN" -c "cmd notification cancel $(printf %q "$TAG")" 2>/dev/null || true
    fi

elif [ "$CMD" = "list" ]; then
    if is_shizuku_enabled && [ -x "$RISH_BIN" ]; then
        "$RISH_BIN" -c "dumpsys notification --noredact" 2>/dev/null | grep -E "pkg=|android.title=|android.text=" | head -n 40
    else
        echo "[agy-notify] rish unavailable to inspect system notification tray"
    fi

else
    echo "$USAGE"
    exit 1
fi
